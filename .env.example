# Copy to `.env` for local development. Bun loads it automatically.
# Production: copy `.env.production.example` and fill in real values.

# --- App ---
# development | production
NODE_ENV=development
PORT=3001
# Public URL of this app (used in logs; set this to your HTTPS origin in prod)
APP_URL=http://127.0.0.1:3001
# Session cookies are Secure in production. Set false only if you serve plain HTTP.
# COOKIE_SECURE=false

# --- Database ---
# sqlite (default) | postgres | mysql
DB_BACKEND=sqlite
# File path when DB_BACKEND=sqlite
SQLITE_PATH=data/planner.db
# Required when DB_BACKEND is postgres or mysql
# DATABASE_URL=postgres://plot:plot@127.0.0.1:5432/plot
# DATABASE_URL=mysql://plot:plot@127.0.0.1:3306/plot

# --- File storage ---
# local (default) | s3
STORAGE_BACKEND=local
# Directory when STORAGE_BACKEND=local
UPLOAD_DIR=data/uploads

# S3 / S3-compatible (MinIO, R2, Spaces, B2, …) when STORAGE_BACKEND=s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=plot
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Path-style URLs (needed for MinIO). Defaults to true when S3_ENDPOINT is set.
# S3_FORCE_PATH_STYLE=true
# Optional object prefix inside the bucket
# S3_PREFIX=uploads
# Optional public/CDN base. If set, /api/files/:id 302s there instead of proxying.
# S3_PUBLIC_URL=https://cdn.example.com
