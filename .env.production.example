# Production template. Copy to the host as `.env` or export these in your process manager.
# Do not commit real credentials.

NODE_ENV=production
PORT=3001
APP_URL=https://plot.example.com
COOKIE_SECURE=true

# postgres | mysql | sqlite
DB_BACKEND=postgres
DATABASE_URL=postgres://plot:change-me@db:5432/plot
# DB_BACKEND=mysql
# DATABASE_URL=mysql://plot:change-me@db:3306/plot
# DB_BACKEND=sqlite
# SQLITE_PATH=/var/lib/plot/planner.db

# local | s3
STORAGE_BACKEND=s3
# UPLOAD_DIR=/var/lib/plot/uploads

S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=plot-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=uploads
# Optional: public bucket or CDN. Leave unset to stream files through /api/files/:id
# S3_PUBLIC_URL=https://uploads.example.com
